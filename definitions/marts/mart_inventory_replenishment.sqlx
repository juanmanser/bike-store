config {
  type: "table",
  schema: "bike_store_marts",
  description: "Alertas de inventario y cantidad sugerida de reposición",
  tags: ["mart", "inventory"]
}

SELECT
  i.snapshot_date,
  i.store_id,
  st.store_name,
  st.city,
  i.product_id,
  p.product_name,
  p.category,
  i.units_on_hand,
  i.reorder_point,
  i.units_on_hand <= i.reorder_point AS needs_reorder,
  GREATEST(2 * i.reorder_point - i.units_on_hand, 0) AS suggested_reorder_quantity
FROM ${ref("stg_inventory")} AS i
JOIN ${ref("stg_stores")} AS st USING (store_id)
JOIN ${ref("stg_products")} AS p USING (product_id)